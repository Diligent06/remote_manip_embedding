{
  "version": "0.2.0",
  "configurations": [
    {
      "preLaunchTask": "build",
      "name": "Debug STM32 with ST-Link",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/FTServo_stm32f103c8t6.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "device": "STM32F103C8",
      "configFiles": [
        "/opt/homebrew/opt/open-ocd/share/openocd/scripts/interface/stlink-v2.cfg",
        // "/opt/homebrew/opt/open-ocd/share/openocd/scripts/interface/cmsis-dap.cfg",
        "/opt/homebrew/opt/open-ocd/share/openocd/scripts/target/stm32f1x.cfg" 
      ],
      "runToMain": true,
      "svdFile": "/Users/srp/Documents/XMU_Robotics/STM32_svdfiles/STM32F103.svd", 
      "preLaunchTask": "build",
      "gdbPath": "/Applications/ARM/bin/arm-none-eabi-gdb"
    }
  ]
}
